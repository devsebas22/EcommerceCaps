# Backend — copiar a .env y completar con valores reales

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_db

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Wompi — clave privada del backend (nunca exponer al frontend)
WOMPI_PRIVATE_KEY=prv_test_...

# Wompi — integrity key (nunca exponer al frontend; usarla solo en el backend para firmar)
VITE_WOMPI_INTEGRITY_KEY=test_integrity_...

# ============================================
# Frontend — VITE_* se inyectan en el bundle JS
# ============================================

# API base URL (vacío = mismo origen, /api = con prefijo)
VITE_API_URL=/api

# ImgBB — key para subir imágenes de productos
VITE_IMGBB_KEY=6a1a8c5652c2864646f87690e024c184

# Wompi — llave pública para el widget de pagos
VITE_WOMPI_PUBLIC_KEY=pub_test_v09zwSBoi8uyLmxVvcYSfXnKj4D0qZvU

# ============================================
# Docker — build args para docker-compose
# ============================================
# Estas variables se usan en docker-compose.yml como build args
# para que Vite las inyecte durante npm run build.
# En Render se configuran como environment variables con flag "Build-time".
VITE_IMGBB_KEY=${VITE_IMGBB_KEY}
VITE_WOMPI_PUBLIC_KEY=${VITE_WOMPI_PUBLIC_KEY}
VITE_WOMPI_INTEGRITY_KEY=${VITE_WOMPI_INTEGRITY_KEY}

# Backend — copiar a .env y completar con valores reales

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_db

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Wompi — clave privada del backend (nunca exponer al frontend)
WOMPI_PRIVATE_KEY=prv_test_...

# Wompi — integrity key (nunca exponer al frontend; usarla solo en el backend para firmar)
VITE_WOMPI_INTEGRITY_KEY=test_integrity_...

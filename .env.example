# ============================================================
# EcommerceCaps — Variables de entorno
# Copiar este archivo a .env en la raíz y completar los valores
# NUNCA subir el .env real al repositorio
# ============================================================

# ── Backend ──────────────────────────────────────────────────

# PostgreSQL — credenciales (usadas por docker-compose para crear el contenedor)
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=ecommerce_db

# Conexión a PostgreSQL
# · Desarrollo local : postgresql://ecommerce_user:...@127.0.0.1:5433/ecommerce_db
# · Docker           : docker-compose.yml lo construye automáticamente desde las vars anteriores
DATABASE_URL=postgresql://ecommerce_user:cambiar_en_produccion@127.0.0.1:5433/ecommerce_db

# Orígenes permitidos para CORS (separados por coma)
# · Producción: poner el dominio real, ej: https://capsco.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave secreta para firmar JWT (mínimo 32 caracteres, aleatoria)
SECRET_KEY=cambiar_en_produccion

# Wompi — clave privada del backend (nunca exponer al frontend)
WOMPI_PRIVATE_KEY=prv_test_...

# Wompi — events secret para verificar firma de webhooks (Panel Wompi > Webhooks)
WOMPI_EVENTS_SECRET=tu_events_secret_de_wompi

# Wompi — integrity key para firmar transacciones (se calcula server-side, NO en frontend)
WOMPI_INTEGRITY_KEY=test_integrity_...

# Sentry — DSN para monitoreo de errores en producción (dejar vacío para desactivar)
SENTRY_DSN=

# Resend — API key para envío de emails transaccionales (resend.com)
RESEND_API_KEY=re_...
# Dominio verificado en Resend para el remitente
RESEND_FROM_EMAIL=noreply@tudominio.com
# URL pública del frontend (para los enlaces en emails)
# · Producción: https://tudominio.com
# · Desarrollo: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Frontend (VITE_*) ─────────────────────────────────────────
# Vite inyecta estas variables en el bundle de producción.
# En desarrollo local, vite.config.js apunta envDir a este .env raíz.
# En Docker, docker-compose.yml las pasa como build args al Dockerfile.

# URL base de la API (sin barra final)
# · Desarrollo local : http://127.0.0.1:8000/api
# · Docker / producción : /api  (mismo origen, con prefijo)
VITE_API_URL=http://127.0.0.1:8000/api

# ImgBB — key para subir imágenes de productos (console.imgbb.com)
VITE_IMGBB_KEY=tu_key_de_imgbb

# Wompi — llave pública para el widget de pagos
VITE_WOMPI_PUBLIC_KEY=pub_test_...

# WhatsApp — número en formato internacional sin + (ej: 573154895642)
VITE_WHATSAPP_NUMBER=573154895642

# Agregar URL de Instagram cuando esté lista, ej: https://instagram.com/capsco
VITE_INSTAGRAM_URL=

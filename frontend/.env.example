# Frontend — copiar a .env y completar con valores reales
# Las variables con prefijo VITE_ se incrustan en el bundle JS y son visibles al navegador

# URL base de la API (sin barra final)
VITE_API_URL=http://localhost:8000

# ImgBB — clave pública para subir imágenes desde el cliente
VITE_IMGBB_KEY=tu_clave_imgbb

# Wompi — clave pública del widget de pago
VITE_WOMPI_PUBLIC_KEY=pub_test_...

# Wompi — integrity key (se usa desde el backend, no desde el frontend)
# La firma se calcula en el endpoint /wompi/firma del backend
# WOMPI_INTEGRITY_KEY debe estar configurada en el backend o Render
